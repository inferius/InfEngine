<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InfEngine.Scripts.Game</RootNamespace>
    <AssemblyName>InfEngine.Scripts.Game</AssemblyName>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfEngine.Scripts.Host\InfEngine.Scripts.Host.csproj">
      <!--
        Game must not embed the host's compiled bits - the host is
        loaded into the default ALC by the runtime, and the game
        lives in a collectible ALC. ReferenceOutputAssembly stays
        true so the compiler resolves Engine.*; Private=false keeps
        the host DLL from being copied into the game's output.
      -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
