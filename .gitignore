*.log
/logs/
/tmp/

# Profiling
flamegraph.svg
perf.data*
*.profraw

# Local secrets / env
.env
.env.local
secrets.toml

# Demo-generated assets (regenerated on first run if missing)
/assets/

# Third-party Mojang Bedrock texture / sound assets bundled
# locally by voxel_demo_mp for fast iteration. These files are
# copyrighted by Mojang and MUST NOT be committed to a public
# repository - the demo falls back to procedural textures /
# synth audio when this directory is absent.
/examples/voxel_demo_mp/assets/

# C# build output
/scripts/**/bin/
/scripts/**/obj/
**/project/scripts/bin/
**/project/scripts/obj/

# Editor scratch files at workspace root
/project.ron
/blueprints/
/scenes/

# Claude harness state
/.claude/

# Build artifacts not under target/
*.exe
*.dll
*.so
*.dylib
*.lib
*.a

# Saved world state (per-installation, not source-controlled)
voxel_server_state.bin
/worlds/

# Asset bundles (big binaries; never commit)
*.zip
mc_assets.zip
# W245.2 exception: the embedded village template data (~780 KB,
# include_bytes! source - the build breaks without it).
!examples/voxel_demo_mp/src/worldgen/mcgen/data/village_data.zip

# Imported adventure-game assets.
# adv-import converts data the user already owns into our format. That
# output is derived from someone else's copyrighted work and must never
# be committed or redistributed - only the decoders are ours to ship.
/imported/
**/imported/
*.room.ron.imported
